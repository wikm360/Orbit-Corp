.env*
!.env.example

# Secrets / keys - never commit
secrets/
!secrets/.gitkeep
*.age
*.pem
*.key
*.bak
*.trn

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo

# Data
Backend/data/uploads/*
!Backend/data/uploads/.gitkeep
# Rahkaran SQL Server backups (.bak/.trn, ~12 GB) - never commit
Backend/data/WIN-*/
Backend/data/rahkaran-backups/
Backend/data/**/*.bak
Backend/data/**/*.trn

# Editors / OS
.DS_Store
.vscode/
system Admin CEO Leader.txt

/Assets
