# Shared routing, imported by Caddyfile (HTTPS) and Caddyfile.http (plain HTTP).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	# API documentation / schema must never be reachable from outside.
	@blocked path /docs /docs/* /redoc /redoc/* /openapi.json /api/docs /api/docs/* /api/redoc /api/redoc/* /api/openapi.json /api/v1/openapi.json
	handle @blocked {
		respond 404
	}

	# Backend (REST + SSE chat stream). No compression and no buffering so SSE events flush immediately.
	# Document uploads (project file manager + chat attachments) get a far larger body limit than the rest of the API:
	# one request carries a file of up to MAX_UPLOAD_SIZE_MB (or an archive of up to MAX_ARCHIVE_SIZE_MB).
	handle /api/* {
		@uploads path_regexp ^/api/v1/(projects/[^/]+/documents|chat/conversations/[^/]+/documents)(/batch)?$
		@other not path_regexp ^/api/v1/(projects/[^/]+/documents|chat/conversations/[^/]+/documents)(/batch)?$
		request_body @uploads {
			max_size 600MB
		}
		request_body @other {
			max_size 60MB
		}
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# Database Admin Panel (SQLAdmin)
	redir /db-admin /db-admin/ 308
	handle /db-admin* {
		reverse_proxy backend:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}
