{
	# Container listens on 8443; compose publishes it as ${BIND_IP}:${PUBLIC_PORT}.
	https_port 8443
	http_port 8080
	auto_https disable_redirects
	admin off
	# Clients that connect to a bare IP (company users via router IP:port) send no SNI: serve the site certificate anyway.
	default_sni {$SITE_ADDRESS:localhost}
}

# SITE_ADDRESS = hostname or IP users type in the browser (default: localhost).
{$SITE_ADDRESS:localhost} {
	# Internal CA. Switch to a real certificate (ACME) once a public domain exists.
	tls internal
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import /etc/caddy/app.caddy
}

# Container-internal health probe (port 8080 is never published).
http://:8080 {
	respond /healthz "ok" 200
}
