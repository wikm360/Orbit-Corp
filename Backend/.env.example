# App
APP_NAME="Organization RAG Assistant"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# CORS (comma-separated, or a JSON array)
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/org_rag

# Redis / RQ
REDIS_URL=redis://localhost:6379/0
INGESTION_QUEUE_NAME=ingestion

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# Access token: short-lived, sent on every request.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token: long-lived, used only to mint a new access token; rotated
# on every use via POST /api/v1/auth/refresh.
REFRESH_TOKEN_EXPIRE_DAYS=30

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# Embedding provider (OpenAI-compatible /v1/embeddings endpoint)
EMBEDDING_API_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1536
# true = also send `dimensions` in each request (OpenAI text-embedding-3-* only, e.g. text-embedding-3-large at 1536).
EMBEDDING_SEND_DIMENSIONS=false

# LLM provider (OpenAI-compatible chat completions endpoint)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_DISABLE_THINKING=false
LLM_STRIP_CONTENT_TAGS=

# Chunking
# OCR of pages with an unusable PDF text layer: concurrent pages per document (total load = WORKER_REPLICAS x this) and a faster vision model
OCR_CONCURRENCY=12
# LLM_VISION_MODEL=gpt-4.1-mini
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
# Hybrid document retrieval (vector + full-text + trigram, fused with RRF). false = vector only.
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_CANDIDATES=30
RETRIEVAL_RRF_K=60
RETRIEVAL_LEXICAL_MIN_TERM_HITS=2
RETRIEVAL_TRIGRAM_ENABLED=true
RETRIEVAL_TRIGRAM_MAX_TERMS=3
RETRIEVAL_TRIGRAM_THRESHOLD=0.65

# Group chat: prefix that triggers an AI reply in a project group chat.
AI_TRIGGER_TOKEN=@bot

# Public sign-ups: set to false to close open registration (first registered user is always super admin).
ALLOW_PUBLIC_REGISTRATION=true

# ---------------------------------------------------------------------------
# Docker Compose mode
# ---------------------------------------------------------------------------
# In development: leave COMPOSE_FILE unset/commented out (loads docker-compose.yml + override).
# In production: uncomment the line below so `docker compose` natively merges the production overlay:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------------------------------------------------------------------------
# Docker / production deployment (docker-compose.prod.yml). PLACEHOLDERS ONLY - generate real values with:
#   openssl rand -hex 24      (hex is URL-safe; passwords are embedded in DATABASE_URL / REDIS_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_hex
POSTGRES_DB=org_rag
REDIS_PASSWORD=CHANGE_ME_hex
# SQL Server: 'sa' password must satisfy the complexity rules (upper+lower+digit+symbol, >= 8 chars)
RAHKARAN_SA_PASSWORD=CHANGE_ME_Complex1!
RAHKARAN_DB_ENABLED=true
RAHKARAN_DB_NAME=MehvarGostar
RAHKARAN_DB_USER=rahkaran_ai_reader
RAHKARAN_DB_PASSWORD=CHANGE_ME
# Express = free, production-licensed. Developer is NOT licensed for production.
MSSQL_PID=Express
# Reverse proxy: address it listens on (keep 127.0.0.1 behind a VPN/tunnel; set the VPN/private IP otherwise) and the name users type
BIND_IP=127.0.0.1
# Host port the proxy listens on = the internal port the router forwards to (e.g. 7496)
PUBLIC_PORT=443
# Caddyfile = HTTPS (recommended). Caddyfile.http = plain HTTP: credentials and data travel unencrypted.
CADDY_CONFIG=Caddyfile
SITE_ADDRESS=localhost
WORKER_REPLICAS=3
ENVIRONMENT=production
DEBUG=false
REQUEST_LOGGING_ENABLED=false
